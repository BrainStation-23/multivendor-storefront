NEXT_PUBLIC_API_URL=http://localhost:4000/api
BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3002

# Match BS-Commerce AUTH_REQUIRED_IDENTIFIER (forgot password + labels).
NEXT_PUBLIC_AUTH_REQUIRED_IDENTIFIER=either

NEXT_PUBLIC_MULTIVENDOR_ENABLED=true
NEXT_PUBLIC_GUEST_CHECKOUT_ENABLED=true
NEXT_PUBLIC_SOCIAL_LOGIN_ENABLED=true
NEXT_PUBLIC_REVIEWS_ENABLED=true
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_SUPPORTED_LOCALES=en,bn
NEXT_PUBLIC_DEFAULT_CURRENCY=USD
NEXT_PUBLIC_SUPPORTED_CURRENCIES=USD,BDT
NEXT_PUBLIC_MULTI_STORE_ENABLED=true
# Must match backend GEOGRAPHY_ENABLED for area-based store list.
NEXT_PUBLIC_GEOGRAPHY_ENABLED=true
NEXT_PUBLIC_SINGLE_STORE_CART=true
# served_and_extended (default) | served_only | all — controls green/gray/red in region dropdowns
NEXT_PUBLIC_GEO_LOCATION_TIER_FILTER=served_and_extended
NEXT_PUBLIC_GEO_LIST_ONLY_SERVED=true

# First-visit: auto-pick first country + default region + store (demo). Omit or false = user must
# select area or use “Use my location” before a store is bound (recommended).
# NEXT_PUBLIC_AUTO_SELECT_DEFAULT_SERVICE_AREA=true

# “Use my location” (reverse geocode via server; geocoder/region policy is configured in code / env).
# NEXT_PUBLIC_GEOLOCATION_PREFILL=true
# Identify your app for Nominatim (https://operations.osmfoundation.org/policies/nominatim/)
# GEOCODER_USER_AGENT="MyStore/1.0 (contact@example.com)"
# Optional: in-memory server cache for reverse results (seconds), policy-friendly (default 7 days).
# GEOCODER_CACHE_TTL_SEC=604800
# Optional: English address fields from Nominatim (default en,en-US). Set bn if you only seed Bangla names.
GEOCODER_ACCEPT_LANGUAGE=en,en-US
